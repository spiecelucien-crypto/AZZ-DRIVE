// Copiez ce fichier en Config/Secrets.xcconfig puis relancez `xcodegen generate`.
// Attention : dans un .xcconfig, « // » commence un commentaire. N'écrivez donc pas « https:// » ici.

// Client ID de votre app sur https:/$()/developer.spotify.com/dashboard
// Redirect URI à déclarer dans le tableau de bord Spotify : azzdrive-spotify://callback
SPOTIFY_CLIENT_ID = 0123456789abcdef0123456789abcdef

// Firebase Realtime Database : uniquement l'hôte, sans « https:// » ni « / » final.
FIREBASE_DATABASE_HOST = azz-drive-default-rtdb.europe-west1.firebasedatabase.app
// Clé d'API Web du projet Firebase (paramètres du projet > Général).
FIREBASE_API_KEY = AIzaSy...

// CarPlay : décommentez une fois le droit « CarPlay Navigation » accordé par Apple
// et ajouté à votre identifiant d'app (compte Apple Developer payant requis).
// CARPLAY_ENTITLEMENTS = Config/CarPlay.entitlements
