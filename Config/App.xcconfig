// Valeurs par défaut : fonctions Spotify et partage désactivées tant qu'elles sont vides.
// Pour les activer, copiez Config/Secrets.example.xcconfig en Config/Secrets.xcconfig
// (fichier ignoré par git) et remplissez-le.
SPOTIFY_CLIENT_ID =
FIREBASE_DATABASE_HOST =
FIREBASE_API_KEY =
// Chemin du fichier de droits CarPlay (laisser vide sans compte Apple Developer payant).
CARPLAY_ENTITLEMENTS =

#include? "Secrets.xcconfig"
